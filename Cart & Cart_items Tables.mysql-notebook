    "caption": "DB Notebook",
    "content": "\\about\nshow DATABASES;\nuse pc_ecommerce;\nshow tables;\nCREATE TABLE cart (\n  id          CHAR(36)    NOT NULL DEFAULT (UUID()),\n  user_id     CHAR(36)    NOT NULL,\n  created_at  TIMESTAMP   NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  updated_at  TIMESTAMP   NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n\n  PRIMARY KEY (id),\n  UNIQUE KEY uq_cart_user_id (user_id),\n  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n);\nCREATE TABLE cart_items (\n  id          CHAR(36)        NOT NULL DEFAULT (UUID()),\n  cart_id     CHAR(36)        NOT NULL,\n  product_id  CHAR(36)        NOT NULL,\n  quantity    INT UNSIGNED    NOT NULL DEFAULT 1,\n  added_at    TIMESTAMP       NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  updated_at  TIMESTAMP       NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n\n  PRIMARY KEY (id),\n  UNIQUE KEY uq_cart_product (cart_id, product_id),\n  FOREIGN KEY (cart_id) REFERENCES cart(id) ON DELETE CASCADE,\n  FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE,\n  INDEX idx_cart_items_cart_id (cart_id),\n  INDEX idx_cart_items_product_id (product_id),\n\n  CHECK (quantity > 0)\n);\nshow tables;\ndesc cart;\ndesc cart_items;\nSELECT * from users limit 10 OFFSET 0;\nSELECT id FROM cart WHERE user_id = '02416024-162f-49c1-9b1e-001398b39474';\n\nSELECT COUNT(*) AS total_customers FROM users WHERE role = 'customer';\nINSERT INTO cart (id, user_id)\nSELECT UUID(), id\nFROM users\nWHERE role = 'customer'\n  AND deleted_at IS NULL\n  AND id NOT IN (SELECT user_id FROM cart);\nSELECT COUNT(*) AS total_carts FROM cart;\nSELECT * from users where role='customer' and deleted_at IS NOT Null;\nSELECT * from cart;\nSELECT id AS cart_id, user_id FROM cart LIMIT 1;\nSELECT id AS product_id, name, price FROM products WHERE status = 'active' LIMIT 1;\n\nINSERT INTO cart_items (cart_id, product_id, quantity)\nVALUES ('cf2e79d8-6c84-11f1-8d71-2c9c583aa7d0', '000902be-a67f-4f87-b09d-5db7888e371d', 2);\nSELECT * from cart_items;\nSELECT\n  ci.id AS cart_item_id,\n  p.name,\n  p.thumbnail_url,\n  ci.quantity,\n  COALESCE(p.discount_price, p.price) AS unit_price,\n  ci.quantity * COALESCE(p.discount_price, p.price) AS total_amount\nFROM cart_items ci\nJOIN products p ON ci.product_id = p.id\nWHERE ci.cart_id = 'cf2e79d8-6c84-11f1-8d71-2c9c583aa7d0';\nSELECT COUNT(*) AS total_cart_items FROM cart_items;\nSELECT * FROM cart_items WHERE quantity > 1;\nSELECT SUM(quantity) AS total_units_in_carts FROM cart_items;\nUPDATE cart_items SET quantity = 3 WHERE id = 'e6ecab64-6c86-11f1-8d71-2c9c583aa7d0';\n\nSELECT * from cart_items;\nSTART TRANSACTION;\nDELETE FROM cart_items WHERE id = 'e6ecab64-6c86-11f1-8d71-2c9c583aa7d0';\n\nSELECT * from cart_items;\nROLLBACK;\nSELECT * FROM cart_items;\nCOMMIT;\nshow tables;\nuse pc_ecommerce;\nshow tables;\n",
