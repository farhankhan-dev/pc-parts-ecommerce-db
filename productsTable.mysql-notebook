s/amd-ryzen-7-5800x3d-v2/1.jpg\", \"https://cdn.pcpartsstore.in/products/amd-ryzen-7-5800x3d-v2/2.jpg\", \"https://cdn.pcpartsstore.in/products/amd-ryzen-7-5800x3d-v2/3.jpg\"]', 'active', 0, 4.44, 498, 'AMD Ryzen 7 5800X3D V2 - Buy Online at Best Price in India', 'Buy AMD Ryzen 7 5800X3D V2 online. Genuine product, GST invoice, fast shipping across India.', '2026-05-22 11:00:34', '2026-05-27 18:00:34', NULL);\nSELECT * from products ORDER BY name ASC LIMIT 50 OFFSET 0;\nSELECT id,name,status,slug FROM products WHERE status='active';\n\nSELECT name,status,price FROM products WHERE status='active' and price <= 3000;\n\nSELECT id,name,status,price FROM products WHERE name LIKE 'Crucial%' ORDER BY name DESC LIMIT 30 OFFSET 0;\nSELECT id,name,price FROM products WHERE price IN (SELECT MAX(price) as highest_price_product FROM products);\nSELECT id,name,price FROM products WHERE price IN (SELECT MIN(price) as highest_price_product FROM products);\n\nSELECT id,name,price,weight_kg FROM products WHERE weight_kg IN (SELECT MAX(weight_kg) as highest_weight_product FROM products);\nSELECT * FROM products WHERE status IN ('draft','active');\n\nCREATE VIEW storefront_products AS\nSELECT\n  id,\n  name,\n  slug,\n  sku,\n  brand,\n  category,\n  short_description,\n\n\n  price,\n  discount_price,\n  COALESCE(discount_price, price) AS final_price,\n  CASE\n    WHEN discount_price IS NOT NULL\n    THEN ROUND(((price - discount_price) / price) * 100, 0)\n    ELSE 0\n  END AS discount_percent,\n  currency,\n\n  CASE\n    WHEN stock_quantity = 0 THEN 'Out of Stock'\n    WHEN stock_quantity <= low_stock_threshold THEN 'Low Stock'\n    ELSE 'In Stock'\n  END AS stock_status,\n  stock_quantity > 0 AS is_purchasable,\n\n\n  thumbnail_url,\n  image_urls,\n\n\n  is_featured,\n\n  rating_average,\n  rating_count,\n\n  meta_title,\n  meta_description,\n\n  created_at\n\nFROM products\nWHERE status = 'active'\n  AND deleted_at IS NULL;\nSELECT * from storefront_products;\nSTART TRANSACTION;\ndrop VIEW storefront_products;\nSHOW FULL TABLES WHERE Table_type = 'VIEW';\nSELECT * from storefront_products;\nROLLBACK;\nSELECT * from storefront_products;\n-- a View Can't be rollback Only DML statements (INSERT, UPDATE, DELETE) are transactional and can be rolled back — not DDL.\nSELECT \n  brand,\n  COUNT(*)              AS total_products,\n  SUM(stock_quantity)    AS total_stock,\n  ROUND(AVG(price), 2)  AS average_price,\n  MAX(price)             AS highest_price,\n  MIN(price)             AS lowest_price\nFROM products\nWHERE deleted_at IS NULL\nGROUP BY brand\nORDER BY total_products DESC;\n",
