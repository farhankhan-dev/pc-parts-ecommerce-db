    "content": "\\about\nuse pc_ecommerce;\nSHOW TABLES;\nCREATE TABLE orders (\n  id                    CHAR(36)        NOT NULL DEFAULT (UUID()),\n  user_id               CHAR(36)        NOT NULL,\n  order_number          VARCHAR(30)     NOT NULL,\n\n  shipping_address_id   CHAR(36)        NOT NULL,\n  billing_address_id    CHAR(36)        NOT NULL,\n\n  status                ENUM('pending', 'confirmed', 'processing', 'shipped',\n                              'out_for_delivery', 'delivered', 'cancelled',\n                              'returned', 'refunded', 'failed')\n                                        NOT NULL DEFAULT 'pending',\n\n  payment_status        ENUM('pending', 'paid', 'failed', 'refunded', 'partially_refunded')\n                                        NOT NULL DEFAULT 'pending',\n  payment_method        VARCHAR(50)     DEFAULT NULL,\n\n  subtotal              DECIMAL(10,2)   NOT NULL,\n  tax_amount            DECIMAL(10,2)   NOT NULL DEFAULT 0.00,\n  shipping_fee          DECIMAL(10,2)   NOT NULL DEFAULT 0.00,\n  discount_amount       DECIMAL(10,2)   NOT NULL DEFAULT 0.00,\n  total_amount          DECIMAL(10,2)   NOT NULL,\n  currency              VARCHAR(3)      NOT NULL DEFAULT 'INR',\n\n  notes                 TEXT            DEFAULT NULL,\n  cancelled_reason      VARCHAR(255)    DEFAULT NULL,\n\n  placed_at             TIMESTAMP       NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  delivered_at          TIMESTAMP       DEFAULT NULL,\n  cancelled_at          TIMESTAMP       DEFAULT NULL,\n  created_at            TIMESTAMP       NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  updated_at            TIMESTAMP       NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n\n  PRIMARY KEY (id),\n  UNIQUE KEY uq_orders_order_number (order_number),\n  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE RESTRICT,\n  FOREIGN KEY (shipping_address_id) REFERENCES addresses(id) ON DELETE RESTRICT,\n  FOREIGN KEY (billing_address_id) REFERENCES addresses(id) ON DELETE RESTRICT,\n  INDEX idx_orders_user_id (user_id),\n  INDEX idx_orders_status (status),\n  INDEX idx_orders_payment_status (payment_status),\n  INDEX idx_orders_placed_at (placed_at)\n);\nDESC orders;\nCREATE TABLE order_items (\n  id                      CHAR(36)        NOT NULL DEFAULT (UUID()),\n  order_id                CHAR(36)        NOT NULL,\n  product_id              CHAR(36)        NOT NULL,\n\n  product_name_snapshot   VARCHAR(255)    NOT NULL,\n  product_sku_snapshot    VARCHAR(100)    NOT NULL,\n  product_image_snapshot  VARCHAR(500)    DEFAULT NULL,\n  unit_price_snapshot     DECIMAL(10,2)   NOT NULL,\n\n  quantity                INT UNSIGNED    NOT NULL DEFAULT 1,\n  line_total              DECIMAL(10,2)   NOT NULL,\n\n  created_at              TIMESTAMP       NOT NULL DEFAULT CURRENT_TIMESTAMP,\n\n  PRIMARY KEY (id),\n  FOREIGN KEY (order_id) REFERENCES orders(id) ON DELETE CASCADE,\n  FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE RESTRICT,\n  INDEX idx_order_items_order_id (order_id),\n  INDEX idx_order_items_product_id (product_id),\n\n  CHECK (quantity > 0)\n);\nDESC order_items;\nINSERT INTO orders\n  (id, user_id, order_number, shipping_address_id, billing_address_id,\n   status, payment_status, payment_method,\n   subtotal, tax_amount, shipping_fee, discount_amount, total_amount, currency,\n   notes, cancelled_reason,\n   placed_at, delivered_at, cancelled_at, created_at, updated_at)\nVALUES\n  ('804c3e8c-1261-43ce-9954-707e83e21c94', '1542f9ed-711e-4b26-a296-187700f69d2d', 'ORD-2025-40180', 'ba8fdc89-d3a0-417f-8b2a-b8add65a27c3', '81d620b1-d363-45cc-95a8-80baf474c5f9', 'delivered', 'paid', 'Credit Card', 302157.0, 54388.26, 0.0, 18852.17, 337693.09, 'INR', NULL, NULL, '2025-09-06 09:47:51', '2025-09-11 09:47:51', NULL, '2025-09-06 09:47:51', '2025-09-19 09:47:51'),\n  ('b0ad90c8-1f52-4fbd-bb14-69195f6f8032', '0afb7074-14d5-4ef9-aa79-a040d6ea4df5', 'ORD-2026-99439', '75a75fc0-5d72-46d0-bc2f-6fa5a702669b', '75a75fc0-5d72-46d0-bc2f