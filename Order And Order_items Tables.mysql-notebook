unt_amount) AS total_discounts FROM orders;\n\nSELECT SUM(total_amount) AS lost_revenue\nFROM orders\nWHERE status IN ('cancelled', 'returned', 'refunded', 'failed');\nSELECT order_number, DATEDIFF(delivered_at, placed_at) AS days_to_deliver\nFROM orders\nWHERE status = 'delivered'\nORDER BY days_to_deliver DESC\nLIMIT 10;\nSELECT order_number, notes FROM orders WHERE notes IS NOT NULL;\n\nSELECT order_number, status, payment_status, total_amount FROM orders WHERE payment_status = 'pending' AND status NOT IN ('cancelled', 'failed');\nSELECT SUM(quantity) AS total_units_sold FROM order_items;\nSELECT product_name_snapshot, COUNT(*) AS times_ordered\nFROM order_items\nGROUP BY product_name_snapshot\nORDER BY times_ordered DESC\nLIMIT 10;\n\nSELECT product_name_snapshot, SUM(quantity) AS total_sold\nFROM order_items\nGROUP BY product_name_snapshot\nORDER BY total_sold DESC\nLIMIT 10;\nSELECT product_name_snapshot, SUM(line_total) AS total_revenue\nFROM order_items\nGROUP BY product_name_snapshot\nORDER BY total_revenue DESC\nLIMIT 10;\nSELECT product_name_snapshot, line_total \nFROM order_items \nORDER BY line_total DESC LIMIT 5;\nSELECT * FROM order_items WHERE quantity >= 3;\n\nSELECT order_id, COUNT(*) AS item_count\nFROM order_items\nGROUP BY order_id\nHAVING COUNT(*) > 3;\nSTART TRANSACTION;\nUPDATE orders \nSET payment_status = 'paid' \nWHERE id = 'c27154fd-60ec-4b9f-ae24-1f7aa2bea2cd';\nSELECT payment_status from orders WHERE id='c27154fd-60ec-4b9f-ae24-1f7aa2bea2cd';\nUPDATE orders \nSET status = 'delivered', delivered_at = NOW()\nWHERE status = 'out_for_delivery' \n  AND placed_at <= NOW() - INTERVAL 3 DAY;\nDELETE FROM orders WHERE id = 'c27154fd-60ec-4b9f-ae24-1f7aa2bea2cd';\n\nROLLBACK;\nSELECT payment_status from orders WHERE id='c27154fd-60ec-4b9f-ae24-1f7aa2bea2cd';\n\n",
